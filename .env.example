# Cloudflare Credentials (required for wrangler deploy)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CF_BUILD_TOKEN=your_cloudflare_api_token_here

# Public Key used to verify Cloudflare Access JWTs in the worker
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Set to "dev" to bypass Cloudflare Access verification with a mocked admin JWT locally
ENVIRONMENT=dev

# The base URL for the public-facing site
VITE_PUBLIC_SITE_URL=http://localhost:8788
