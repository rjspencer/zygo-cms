{
    "name": "zygo-cms",
    "version": "0.2.1",
    "type": "module",
    "engines": {
        "pnpm": ">11.0.0"
    },
    "scripts": {
        "dev": "concurrently -k -c \"blue,green,magenta,cyan\" -n \"api,public,ui,watch:api\" \"pnpm run dev:api:serve\" \"pnpm run dev:public\" \"pnpm run dev:ui\" \"pnpm run watch:api\"",
        "dev:api": "concurrently -k -c \"blue,cyan\" -n \"api,watch:api\" \"pnpm run dev:api:serve\" \"pnpm run watch:api\"",
        "dev:api:serve": "wrangler dev packages/admin-api-worker/build/index.js -c packages/admin-api-worker/wrangler.toml --port 8787 --persist-to=./.wrangler/state",
        "dev:public": "node scripts/wait.mjs 3000 && wrangler dev packages/public-worker/build/index.js -c packages/public-worker/wrangler.toml --port 8788 --persist-to=./.wrangler/state",
        "dev:ui": "pnpm --filter admin-ui run dev",
        "watch:api": "node scripts/watch-worker.mjs packages/admin-api-worker",
        "build": "node scripts/build.mjs",
        "build:api": "cd packages/admin-api-worker && worker-build --release",
        "build:public": "cd packages/public-worker && worker-build --release",
        "build:rust": "pnpm --filter template-wasm run build && pnpm run build:api && pnpm run build:public",
        "build:ui": "pnpm --filter admin-ui run build",
        "build:wasm": "pnpm --filter template-wasm run build",
        "db:migrate": "wrangler d1 migrations apply zygo-cms-db --remote -c packages/admin-api-worker/wrangler.toml",
        "db:migrate:local": "wrangler d1 migrations apply zygo-cms-db --local --persist-to=./.wrangler/state -c packages/admin-api-worker/wrangler.toml",
        "db:reset": "node scripts/db-reset.mjs --local",
        "db:reset:remote": "node scripts/db-reset.mjs --remote",
        "deploy": "pnpm run deploy:public && pnpm run deploy:api && pnpm run deploy:ui",
        "deploy:public": "wrangler deploy -c packages/public-worker/wrangler.toml",
        "deploy:api": "wrangler deploy -c packages/admin-api-worker/wrangler.toml",
        "deploy:ui": "wrangler deploy -c packages/admin-ui/wrangler.toml",
        "setup": "node scripts/setup.mjs",
        "wizard": "node scripts/setup.mjs",
        "create:component": "node scripts/create-component-module.mjs",
        "seed:docs:official": "node scripts/seed_official_docs.mjs",
        "seed:theme-preview": "node scripts/seed_theme_preview.mjs",
        "test:admin": "vitest run packages/admin-ui/",
        "test:api": "vitest run tests/admin-api-worker.test.js",
        "test:public": "vitest run tests/public-worker.test.js",
        "test:create": "vitest run tests/create-zygo-app.test.js",
        "test:e2e": "vitest run --no-file-parallelism tests/",
        "test:all": "vitest run",
        "test": "vitest run"
    },
    "devDependencies": {
        "@clack/prompts": "^1.8.1",
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/user-event": "^14.6.1",
        "@vitest/coverage-v8": "^3.2.7",
        "autoprefixer": "^10.6.1",
        "concurrently": "^10.0.5",
        "happy-dom": "^17.1.0",
        "picocolors": "^1.1.1",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "vite": "^7.3.6",
        "vitest": "^3.0.7",
        "wrangler": "^4.133.0"
    }
}