{
    "name": "zygo-cms",
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "pnpm": ">11.0.0"
    },
    "scripts": {
        "dev": "concurrently -k -c \"blue,green,magenta\" -n \"api,public,ui\" \"pnpm run dev:api\" \"pnpm run dev:public\" \"pnpm run dev:ui\"",
        "dev:api": "wrangler dev packages/admin-api-worker/build/index.js -c packages/admin-api-worker/wrangler.toml --port 8787 --persist-to=./.wrangler/state",
        "dev:public": "sleep 3 && wrangler dev packages/public-worker/build/index.js -c packages/public-worker/wrangler.toml --port 8788 --persist-to=./.wrangler/state",
        "dev:ui": "pnpm --filter admin-ui run dev",
        "build": "pnpm run build:api && pnpm run build:public && pnpm run build:ui",
        "build:api": "cd packages/admin-api-worker && worker-build --release",
        "build:public": "cd packages/public-worker && worker-build --release",
        "build:ui": "pnpm --filter admin-ui run build",
        "db:migrate:local": "wrangler d1 migrations apply zygo-cms-db --local --persist-to=./.wrangler/state -c packages/admin-api-worker/wrangler.toml",
        "deploy": "pnpm run deploy:public && pnpm run deploy:api && pnpm run deploy:ui",
        "deploy:public": "wrangler deploy -c packages/public-worker/wrangler.toml",
        "deploy:api": "wrangler deploy -c packages/admin-api-worker/wrangler.toml",
        "deploy:ui": "wrangler deploy -c packages/admin-ui/wrangler.toml",
        "setup": "node scripts/setup.mjs",
        "seed:docs:official": "node scripts/seed_official_docs.mjs",
        "test": "vitest run packages/admin-ui/src/__tests__/Editor.test.tsx",
        "test:e2e": "vitest run --no-file-parallelism tests/",
        "test:all": "vitest run"
    },
    "devDependencies": {
        "@clack/prompts": "^1.8.1",
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/user-event": "^14.6.1",
        "@vitest/coverage-v8": "^3.2.7",
        "autoprefixer": "^10.6.1",
        "concurrently": "^10.0.5",
        "happy-dom": "^17.1.0",
        "picocolors": "^1.1.1",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "vite": "^7.3.6",
        "vitest": "^3.0.7",
        "wrangler": "^4.133.0"
    }
}