{
    "name": "zygo-cms",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -c \"blue,green,magenta\" -n \"api,public,ui\" \"npm run dev:api\" \"npm run dev:public\" \"npm run dev:ui\"",
        "dev:api": "wrangler dev packages/admin-api-worker/build/index.js -c wrangler.toml --port 8787",
        "dev:public": "sleep 3 && wrangler dev packages/public-worker/build/index.js -c wrangler.toml --port 8788",
        "dev:ui": "npm --prefix packages/admin-ui run dev",
        "build": "npm run build:api && npm run build:public && npm run build:ui",
        "build:api": "cd packages/admin-api-worker && worker-build --release",
        "build:public": "cd packages/public-worker && worker-build --release",
        "build:ui": "npm --prefix packages/admin-ui run build",
        "test": "vitest run packages/admin-ui/src/__tests__/Editor.test.tsx",
        "test:e2e": "vitest run --no-file-parallelism tests/",
        "test:all": "vitest run"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/user-event": "^14.6.1",
        "@vitest/coverage-v8": "^3.2.7",
        "autoprefixer": "^10.6.1",
        "concurrently": "^10.0.5",
        "happy-dom": "^17.1.0",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "vite": "^7.3.6",
        "vitest": "^3.0.7",
        "wrangler": "^4.133.0"
    }
}
