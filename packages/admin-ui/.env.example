# Admin UI Environment Variables

# The base URL for the admin-api-worker. 
# Locally, Cloudflare Wrangler typically hosts workers on port 8787.
# In production, this should point to your live API domain (e.g. https://api.zygodactylstudios.com)
VITE_API_BASE_URL=http://127.0.0.1:8787

# The base URL for the public-facing site.
# Useful for generating "View Live" links in the CMS.
VITE_PUBLIC_SITE_URL=http://localhost:8788
